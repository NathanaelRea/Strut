def test_pow_matches_libm_in_every_lane_and_width():
    var reference = _pow_reference()
    var count = len(reference) // 3
    for i in range(count):
        var x = reference[3 * i]
        var y = reference[3 * i + 1]
        var expected = reference[3 * i + 2]
        # The error of exp(y * log(x)) grows with |y * log(x)|; 1e-13 covers the table.
        var scalar = simd_pow_nonneg[1](SIMD[DType.float64, 1](x), SIMD[DType.float64, 1](y))
        assert_true(_relative_error(scalar[0], expected) <= 1.0e-13)
        var wide = simd_pow_nonneg[8](SIMD[DType.float64, 8](x), SIMD[DType.float64, 8](y))
        for lane in range(8):
            assert_equal(wide[lane], scalar[0])


def test_pow_is_far_tighter_than_one_part_in_a_billion_for_material_exponents():
    # Regression guard for the reason this module exists: the builtin `**` is
    # off by up to 3e-8 for fractional exponents.
    var root = simd_pow_nonneg[4](
        SIMD[DType.float64, 4](4.0, 9.0, 16.0, 2.25), SIMD[DType.float64, 4](0.5)
    )
    assert_true(_relative_error(root[0], 2.0) <= 4.0e-16)
    assert_true(_relative_error(root[1], 3.0) <= 4.0e-16)
    assert_true(_relative_error(root[2], 4.0) <= 4.0e-16)
    assert_true(_relative_error(root[3], 1.5) <= 4.0e-16)


def test_pow_zero_base_conventions():
    var got = simd_pow_nonneg[4](
        SIMD[DType.float64, 4](0.0), SIMD[DType.float64, 4](2.0, 0.8, 0.0, -1.0)
    )
    assert_equal(got[0], 0.0)
    assert_equal(got[1], 0.0)
    assert_equal(got[2], 1.0)
    assert_true(isinf(got[3]) and got[3] > 0.0)


def test_pow_mixed_lanes_do_not_disturb_each_other():
    var x = SIMD[DType.float64, 8](0.0, 1.0, 2.0, 1.0e-310, 4.0, 0.5, 1.0e300, 9.0)
    var y = SIMD[DType.float64, 8](2.0, 123.0, 10.0, 0.8, 0.5, -3.0, 1.5, 0.5)
    var got = simd_pow_nonneg[8](x, y)
    for lane in range(8):
        var alone = simd_pow_nonneg[1](
            SIMD[DType.float64, 1](x[lane]), SIMD[DType.float64, 1](y[lane])
        )
        assert_equal(got[lane], alone[0])
    assert_equal(got[2], 1024.0)
    assert_true(isinf(got[6]))


def test_scalar_pow_is_bit_identical_to_the_simd_lanes():
    # Scalar and SIMD material paths must agree exactly, so they share one pow.
    var reference = _pow_reference()
    var count = len(reference) // 3
    for i in range(count):
        var x = reference[3 * i]
        var y = reference[3 * i + 1]
        var wide = simd_pow_nonneg[8](SIMD[DType.float64, 8](x), SIMD[DType.float64, 8](y))
        assert_equal(pow_nonneg(x, y), wide[0])
        assert_equal(pow_nonneg(x, y), wide[7])


def test_log_matches_libm_within_two_ulp():
    var reference = _log_reference()
    var count = len(reference) // 2
    for i in range(count):
        var x = reference[2 * i]
        var expected = reference[2 * i + 1]
        var got = simd_log[8](SIMD[DType.float64, 8](x))
        if expected == 0.0:
            assert_equal(got[0], 0.0)
        else:
            assert_true(_relative_error(got[0], expected) <= 4.5e-16)
        assert_equal(got[7], got[0])


def test_exp_matches_libm_within_two_ulp():
    var reference = _exp_reference()
    var count = len(reference) // 2
    for i in range(count):
        var x = reference[2 * i]
        var expected = reference[2 * i + 1]
        var got = simd_exp[8](SIMD[DType.float64, 8](x))
        assert_true(_relative_error(got[0], expected) <= 4.5e-16)
        assert_equal(got[7], got[0])


def test_exp_saturates_outside_the_float64_range():
    var got = simd_exp[4](SIMD[DType.float64, 4](800.0, -800.0, 710.0, -746.0))
    assert_true(isinf(got[0]) and got[0] > 0.0)
    assert_equal(got[1], 0.0)
    assert_true(isinf(got[2]) and got[2] > 0.0)
    assert_equal(got[3], 0.0)


def main():
    TestSuite.discover_tests[__functions_in_module()]().run()
