"""Tests for simd_math against libm reference values (generated with Python math)."""

from math import isinf
from testing import assert_equal, assert_true, TestSuite

from simd_math import pow_nonneg, simd_exp, simd_log, simd_pow_nonneg


fn _relative_error(got: Float64, expected: Float64) -> Float64:
    if expected == 0.0:
        return abs(got)
    return abs(got - expected) / abs(expected)


