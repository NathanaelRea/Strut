set nodeTags {}
for {set tag 1} {$tag <= 12120} {incr tag} {
    lappend nodeTags $tag
}
foreach tag [lsort $nodeTags] {
    set base [expr {($tag - 1) % 120}]
    set elevation [expr {($tag - 1) / 120}]
    node $tag {*}[lindex $coordinates $base] $elevation
    if {$elevation == 0} {
        fix $tag 1 1 1
    }
}

set brickTags {}
for {set tag 1} {$tag <= 8000} {incr tag} {
    lappend brickTags $tag
}
foreach tag [lsort $brickTags] {
    set base [expr {($tag - 1) % 80}]
    set offset [expr {120 * (($tag - 1) / 80)}]
    set bottom {}
    set top {}
    foreach corner [lindex $quadrilaterals $base] {
        lappend bottom [expr {$corner + $offset}]
        lappend top [expr {$corner + $offset + 120}]
    }
    element stdBrick $tag {*}$bottom {*}$top 1
}

pattern Plain 1 Linear {
    for {set tag 12001} {$tag <= 12120} {incr tag} {
        load $tag 1 -1 0
    }
}

integrator LoadControl 200
system Umfpack
analysis Static
analyze 1
